---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import { getSheets } from '../lib/sheets';

const sheets = await getSheets();
const posts = (await getCollection('blog'))
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0))
  .slice(0, 4);
const formatDate = (date?: Date) =>
  date ? date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' }) : '';

const seo = {
  title: 'Home',
  description: 'Machine learning, hardware and software by Faisal Durbaa: award-winning models, competition builds and writing, each with its report or code.',
};
---
<Layout seo={seo}>
  {/* On wide screens the headline and figure hold still; only the index scrolls. */}
  <div class="hero pad grid gap-x-12 gap-y-8 pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,44%)]">
    <div class="flex min-h-0 flex-col">
      <h1 class="disp text-ink text-[clamp(2.75rem,5.6vw,4.75rem)]">Models, machines, <span class="text-mark">software.</span></h1>
      <p class="mt-4 max-w-xl text-lg">
        Work by Faisal Durbaa in machine learning, hardware and software. Each sheet carries its result and the report or code behind it.
      </p>
      <ol class="index mt-7 min-h-0 flex-1 lg:overflow-y-auto" id="sheet-index" tabindex="-1">
        {sheets.map((sheet, i) => (
          <li>
            <a class="index-row" href={sheet.href} data-sheet={i} data-on={i === 0 ? 'true' : undefined}>
              <span class="no">{sheet.no}</span>
              <span>
                <span class="ttl">{sheet.title}</span>
                <span class="lab">{sheet.context}</span>
              </span>
              <span class:list={['out', { win: sheet.win }]}>{sheet.outcome}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <aside class="row-start-2 min-h-0 lg:row-start-auto" aria-label="Selected sheet">
      <div class="frame h-full">
        {sheets.map((sheet, i) => (
          <div class="flex h-full flex-col p-5 sm:p-6" data-panel={i} hidden={i !== 0}>
            <div class="flex min-h-0 flex-1 items-center justify-center">
              {sheet.figure ? (
                <Figure name={sheet.figure} title={sheet.title} class="w-full max-w-[min(100%,52vh)] text-ink" />
              ) : sheet.image ? (
                <img src={sheet.image} alt="" class="plate max-h-[44vh] w-full object-cover" loading="lazy" />
              ) : null}
            </div>
            <p class="lab mt-5 border-t border-rule pt-4 text-ink">Fig. {sheet.no} — {sheet.title}</p>
            <p class="mt-2">{sheet.summary}</p>
            {sheet.win && <p class="mt-4"><span class="stamp">{sheet.outcome}</span></p>}
          </div>
        ))}
      </div>
    </aside>
  </div>

  <section class="pad mt-20 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,44%)]">
    <div>
      <h2 class="disp text-ink text-4xl">Writing</h2>
      <ol class="index mt-5">
        {posts.map((post: CollectionEntry<'blog'>) => (
          <li>
            <a class="index-row" href={`/blog/${post.id}/`}>
              <span class="lab">{formatDate(post.data.publishDate)}</span>
              <span class="ttl">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mt-6 flex flex-wrap gap-3">
        <a class="btn" href="/blog/">All writing</a>
        <a class="btn" href="/courses/ms-excel-documentation/">Excel course</a>
      </p>
    </div>
    <div class="lg:pt-14">
      <p class="max-w-md text-lg">Working on something where this would help, or want the details behind a sheet?</p>
      <p class="mt-5"><a class="btn-solid" href="/contact/">Get in touch</a></p>
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 1024px) {
    .hero { height: calc(100dvh - 6.75rem); min-height: 34rem; }
  }
  [data-panel][hidden] { display: none; }
  /* Photos sit in the sheet as single-ink plates. */
  .plate { filter: grayscale(1) contrast(1.1); mix-blend-mode: luminosity; border: 1px solid var(--rule); }
</style>

<script>
  // Moving through the index swaps the framed figure. Without JS the first sheet stays shown.
  function bindIndex() {
    const rows = document.querySelectorAll<HTMLElement>('#sheet-index [data-sheet]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    const show = (id: string) => {
      rows.forEach((row) => (row.dataset.sheet === id ? (row.dataset.on = 'true') : delete row.dataset.on));
      panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== id));
    };
    rows.forEach((row) => {
      const id = row.dataset.sheet!;
      row.addEventListener('mouseenter', () => show(id));
      row.addEventListener('focus', () => show(id));
    });
  }
  bindIndex();
  document.addEventListener('astro:after-swap', bindIndex);
</script>
