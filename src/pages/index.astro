---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import { getSheets } from '../lib/sheets';

const sheets = await getSheets();
const posts = (await getCollection('blog'))
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0))
  .slice(0, 4);
const formatDate = (date?: Date) =>
  date ? date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' }) : '';

const seo = {
  title: 'Home',
  description: 'Hardware and software by Faisal Durbaa: competition builds, machine-learning projects and writing, each with its report or repository.',
};
---
<Layout seo={seo}>
  <div class="pad grid gap-x-12 gap-y-8 pt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,44%)]">
    <div>
      <h1 class="disp text-ink text-[clamp(2.75rem,6vw,4.75rem)]">Built, tested, judged.</h1>
      <p class="mt-4 max-w-xl text-lg">
        Hardware and software by Faisal Durbaa. One sheet per project: what it does, how it was judged, and the report behind it.
      </p>
    </div>
    <aside class="lg:col-start-2 lg:row-start-1 lg:row-span-2" aria-label="Selected sheet">
      <div class="frame lg:sticky lg:top-6">
        {sheets.map((sheet, i) => (
          <div class="p-5 sm:p-6" data-panel={i} hidden={i !== 0}>
            {sheet.figure ? (
              <Figure name={sheet.figure} title={sheet.title} class="mx-auto max-h-[52vh] max-w-md text-ink" />
            ) : sheet.image ? (
              <img src={sheet.image} alt="" class="plate w-full max-h-[44vh] object-cover" loading="lazy" />
            ) : null}
            <p class="lab mt-5 border-t border-rule pt-4 text-ink">
              Fig. {sheet.no} — {sheet.title}{sheet.figure && ' (illustrative, not to scale)'}
            </p>
            <p class="mt-2">{sheet.summary}</p>
            {sheet.win && <p class="stamp mt-5">{sheet.outcome}</p>}
          </div>
        ))}
      </div>
    </aside>

    <div class="lg:col-start-1">
      <ol class="index" id="sheet-index">
        {sheets.map((sheet, i) => (
          <li>
            <a class="index-row" href={sheet.href} data-sheet={i} data-on={i === 0 ? 'true' : undefined}>
              <span class="no">{sheet.no}</span>
              <span>
                <span class="ttl">{sheet.title}</span>
                <span class="lab">{sheet.context}</span>
              </span>
              <span class:list={['out', { win: sheet.win }]}>{sheet.outcome}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <section class="pad mt-20 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,44%)]">
    <div>
      <h2 class="disp text-ink text-4xl">Writing</h2>
      <ol class="index mt-5">
        {posts.map((post: CollectionEntry<'blog'>) => (
          <li>
            <a class="index-row" href={`/blog/${post.id}/`}>
              <span class="lab">{formatDate(post.data.publishDate)}</span>
              <span class="ttl">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mt-6 flex flex-wrap gap-3">
        <a class="btn" href="/blog/">All writing</a>
        <a class="btn" href="/courses/ms-excel-documentation/">Excel course</a>
      </p>
    </div>
    <div class="lg:pt-14">
      <p class="max-w-md text-lg">Working on something where this would help, or want the details behind a sheet?</p>
      <p class="mt-5"><a class="btn-solid" href="/contact/">Get in touch</a></p>
    </div>
  </section>
</Layout>

<style>
  /* Photos sit in the sheet as single-ink plates. */
  .plate { filter: grayscale(1) contrast(1.1); mix-blend-mode: luminosity; border: 1px solid var(--rule); }
</style>

<script>
  // Moving through the index swaps the framed figure. Without JS the first sheet stays shown.
  function bindIndex() {
    const rows = document.querySelectorAll<HTMLElement>('#sheet-index [data-sheet]');
    const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
    const show = (id: string) => {
      rows.forEach((row) => (row.dataset.sheet === id ? (row.dataset.on = 'true') : delete row.dataset.on));
      panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== id));
    };
    rows.forEach((row) => {
      const id = row.dataset.sheet!;
      row.addEventListener('mouseenter', () => show(id));
      row.addEventListener('focus', () => show(id));
    });
  }
  bindIndex();
  document.addEventListener('astro:after-swap', bindIndex);
</script>
