---
import InkBlots from '../../components/InkBlots.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogEntries = await getCollection('blog');
const fallbackDate = new Date('1970-01-01');

const sortedContent = blogEntries.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
  (b.data.publishDate ? new Date(b.data.publishDate) : fallbackDate).valueOf() -
  (a.data.publishDate ? new Date(a.data.publishDate) : fallbackDate).valueOf()
);


const seo = {
  title: "Blog",
  description: "Explore my latest blog posts on AI, software, and technical strategy.",
};
---
<Layout seo={seo}>
  <div class="relative overflow-hidden">
    <InkBlots />

    <div class="pad relative pt-10 pb-16 max-w-[1100px]">
      <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4.5rem)]">Writing</h1>
      <p class="mt-4 mb-10 max-w-[70ch] text-lg text-muted">Domesitcating technical advancements in technology and business.</p>

      <ul id="blog-grid" class="entries">
        {sortedContent.map((item: CollectionEntry<'blog'>) => (
          <li>
            <a href={`/blog/${item.id}/`} class="entry">
              <span class="thumb" aria-hidden="true">
                {item.data.heroImage && <img src={item.data.heroImage} alt="" class="plate" loading="lazy" />}
              </span>
              <span class="min-w-0">
                {item.data.publishDate && (
                  <span class="lab block text-muted">
                    {new Date(item.data.publishDate).toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                )}
                <span class="disp ttl text-ink">{item.data.title}</span>
                <span class="mt-2 block max-w-[70ch]">{item.data.description}</span>
                {item.data.tags && item.data.tags.length > 0 && (
                  <span class="lab mt-3 block text-muted">{item.data.tags.join(' / ')}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<style>

  .entries { list-style: none; padding: 0; border-top: 2px solid var(--ink); }
  .entry { display: grid; gap: 1rem; padding: 1.25rem .75rem; border-bottom: 1px solid var(--rule); border-left: 3px solid transparent; text-decoration: none; color: inherit; background: var(--ground); }
  @media (min-width: 640px) { .entry { grid-template-columns: 180px minmax(0, 1fr); gap: 1.5rem; align-items: start; } }
  .thumb { display: block; height: 160px; border: 1px solid var(--rule); overflow: hidden; background: var(--panel); }
  @media (min-width: 640px) { .thumb { height: auto; aspect-ratio: 3 / 2; } }
  .thumb .plate { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); mix-blend-mode: luminosity; }
  .ttl { display: block; margin-top: .25rem; font-size: clamp(1.4rem, 3vw, 1.75rem); }
  .entry:hover, .entry:focus-visible { border-left-color: var(--mark); }
  .entry:hover .thumb, .entry:focus-visible .thumb { border-color: var(--mark); }
  .entry:hover .ttl, .entry:focus-visible .ttl { color: var(--mark); }
</style>
