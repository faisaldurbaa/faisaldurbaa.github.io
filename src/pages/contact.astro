---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Figure from '../components/Figure.astro';

const seo = {
  title: "Contact",
  description: "Get in touch with Faisal Durbaa. Send a message via the contact form or connect on social media."
};
const formspreeFormId = import.meta.env.PUBLIC_FORMSPREE_ID ?? '';
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? '';
---
<Layout seo={seo}>
  <div class="pad pt-6 pb-4 contact flex flex-col lg:grid lg:grid-cols-2 lg:gap-12">
    <section class="contents lg:flex lg:min-h-0 lg:flex-col">
      <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4rem)]">Let&apos;s get in touch</h1>
      <p class="mt-3 max-w-[60ch]">
        Tell me what you&apos;re working on or what you need help with. I&apos;ll reply with next steps.
      </p>
      <p class="mt-2 max-w-[60ch] text-muted">Helpful details: context or topic; what you&apos;re looking for (collaboration, feedback...); links (repo/brief) optional.</p>
      <div class="order-5 mt-6 lg:order-none lg:min-h-0 lg:flex-1">
        <Figure name="contact" title="Send a message" class="contact-fig max-w-[22rem] lg:max-w-none" />
      </div>
      <p class="order-4 mt-5 flex flex-wrap gap-x-6 gap-y-2 lg:order-none lg:mt-4">
        <a href="https://github.com/faisaldurbaa" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-ink underline"><Icon name="mdi:github" width="20" height="20" aria-hidden="true" />GitHub</a>
        <a href="https://www.linkedin.com/in/faisaldurbaa/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-ink underline"><Icon name="mdi:linkedin" width="20" height="20" aria-hidden="true" />LinkedIn</a>
      </p>
    </section>

    <div class="frame mt-8 p-4 lg:mt-0 lg:self-start" id="contact-form-section">
      <div id="success-message" class="hidden border-2 border-ink px-3 py-2 mb-3" role="alert" aria-live="polite">
        <strong class="font-semibold">Thanks!</strong> Your message has been sent.
      </div>
      <div id="error-message" class="hidden border-2 border-stamp text-stamp px-3 py-2 mb-3" role="alert" aria-live="polite">
        <strong class="font-semibold">Not sent.</strong> <span id="error-detail">Something went wrong. Please try again.</span>
      </div>

      <form id="contact-form" class="space-y-3" autocomplete="on">
        <div>
          <label for="name" class="lab block mb-1 text-ink">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full border-2 border-ink bg-ground text-body px-3 py-2 rounded-none" />
        </div>
        <div>
          <label for="email" class="lab block mb-1 text-ink">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full border-2 border-ink bg-ground text-body px-3 py-2 rounded-none" />
        </div>
        <div>
          <label for="message" class="lab block mb-1 text-ink">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full border-2 border-ink bg-ground text-body px-3 py-2 rounded-none"></textarea>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <span class="text-muted">I&apos;ll get back to you shortly.</span>
          <button id="submit-button" type="submit" class="btn-solid justify-center">Send Message</button>
        </div>
        <p class="mt-3 text-sm text-muted">
          Protected by reCAPTCHA. Google's <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a> apply.
        </p>
      </form>
    </div>
  </div>
</Layout>

<style is:global>
  @media (min-width: 1024px) {
    /* Fill the viewport above the footer, but grow (and scroll) when the form plus a status message is taller; a fixed height let it spill over the footer. */
    .contact { min-height: calc(100svh - 17.5rem); }
    /* Out of flow so the drawing fills the leftover space without setting the row height. */
    .contact-fig { position: absolute; inset: 0; }
    .contact-fig .figure { height: 100%; max-height: 100%; }
    .contact section > div { position: relative; }
  }
</style>

<script is:inline define:vars={{ formspreeFormId, recaptchaSiteKey }}>
  // Bound once per form element, so returning to this page via client navigation never doubles submissions.
  function bindContact() {
    const form = document.getElementById('contact-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    const errorDetail = document.getElementById('error-detail');
    const submitButton = document.getElementById('submit-button');

    if (!document.getElementById('recaptcha-script')) {
      const script = document.createElement('script');
      script.id = 'recaptcha-script';
      script.src = `https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`;
      script.async = true;
      document.head.appendChild(script);
    }

    const showError = (detail) => {
      errorDetail.textContent = detail || 'Something went wrong. Please try again, or reach me on LinkedIn.';
      errorMessage.classList.remove('hidden');
      successMessage.classList.add('hidden');
    };
    const setBusy = (busy) => {
      submitButton.disabled = busy;
      submitButton.textContent = busy ? 'Sending…' : 'Send Message';
    };
    // reCAPTCHA can hang when blocked by an extension or network; give up after 10 s instead of doing nothing.
    const getToken = () => new Promise((resolve, reject) => {
      if (!window.grecaptcha) return reject(new Error('The spam check did not load. Disable content blockers for this page and try again.'));
      const timer = setTimeout(() => reject(new Error('The spam check timed out. Please try again.')), 10000);
      grecaptcha.ready(() => grecaptcha.execute(recaptchaSiteKey, { action: 'submit' }).then(
        (token) => { clearTimeout(timer); resolve(token); },
        () => { clearTimeout(timer); reject(new Error('The spam check failed. Please try again.')); },
      ));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitButton.disabled) return;
      setBusy(true);
      try {
        const formData = new FormData(form);
        formData.append('g-recaptcha-response', await getToken());
        const response = await fetch(`https://formspree.io/f/${formspreeFormId}`, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          form.reset();
          successMessage.classList.remove('hidden');
          errorMessage.classList.add('hidden');
          setTimeout(() => successMessage.classList.add('hidden'), 6000);
        } else {
          // Formspree explains rejections (validation, limits, spam); show its words.
          const data = await response.json().catch(() => ({}));
          showError(data.errors?.map((x) => x.message).join('. ') || data.error);
        }
      } catch (err) {
        showError(err instanceof Error && err.message !== 'Failed to fetch' ? err.message : 'Could not reach the mail service. Check your connection and try again.');
      } finally {
        setBusy(false);
      }
    });
  }
  bindContact();
  document.addEventListener('astro:page-load', bindContact);
</script>
