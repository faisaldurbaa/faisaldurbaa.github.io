---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Page Not Found",
  description: "The page you are looking for could not be found.",
  noindex: true
};
---
<Layout seo={seo}>
  <div class="pad pt-10 pb-20">
    <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4.5rem)]">Page Not Found</h1>
    <p class="prose-sheet mt-4">Sorry, we couldn't find the page you were looking for.</p>
    <p class="mt-8"><a href="/" class="btn">Go Back Home</a></p>
  </div>
</Layout>
