---
import Layout from '../../layouts/Layout.astro';
import CompetitionShowcase from '../../components/CompetitionShowcase.astro';
import competitionProjectsTr from '../../data/competitionProjects.tr';

const seo = {
  title: 'TEKNOFEST ve TÜBİTAK Projeleri',
  description: 'Okulumu temsilen katıldığım TEKNOFEST ve TÜBİTAK yarışmalarındaki projeler, elde edilen başarılar ve proje raporları.',
};
---
<Layout
  seo={seo}
  lang="tr"
  languageSwitch={{ current: 'tr', alternateHref: '/en/red/teknofest-tubitak/', alternateLabel: 'English', accessibleLabel: 'İngilizceye geç' }}
  alternateLanguages={[
    { lang: 'tr', href: '/red/teknofest-tubitak/' },
    { lang: 'en', href: '/en/red/teknofest-tubitak/' },
    { lang: 'x-default', href: '/red/teknofest-tubitak/' },
  ]}
>
  <CompetitionShowcase
    projects={competitionProjectsTr}
    copy={{
      title: 'TEKNOFEST ve TÜBİTAK PROJELERİ',
      intro: 'Okulumu temsilen katıldığım TEKNOFEST ve TÜBİTAK yarışmalarında yer alan başlıca projeleri, kısa özetleri ve raporlarıyla birlikte inceleyebilirsiniz.',
      teknofest: 'Havacılık, Uzay ve Teknoloji Festivali kapsamında düzenlenen yarışmalar, öğrencilerin donanım ve yazılım alanlarında geliştirdiği özgün projeleri bir araya getirir.',
      tubitak: 'Türkiye Bilimsel ve Teknolojik Araştırma Kurumudur; öğrencilere yönelik ülke çapında araştırma projesi yarışmaları düzenler.',
      projectCount: 'proje',
      disciplines: 'Donanım ve yazılım',
      reports: 'Proje raporları',
      problem: 'Problem',
      solution: 'Çözüm',
      themes: {
        safety: 'Kamu Güvenliği',
        health: 'Sağlık',
        accessibility: 'Erişilebilirlik',
        environment: 'Çevre',
        education: 'Eğitim',
      },
    }}
  />
</Layout>
