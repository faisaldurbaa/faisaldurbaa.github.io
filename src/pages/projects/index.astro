---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CompetitionCard from '../../components/CompetitionCard.astro';
import competitionProjects from '../../data/competitionProjects';

const projectEntries = await getCollection('projects');
const courseEntries = (await getCollection('courses')).filter(
  (course: CollectionEntry<'courses'>) => course.data.lessonNumber === undefined
);
const fallbackDate = new Date('1970-01-01');

const combinedBuilds = [
  ...projectEntries.map((item: CollectionEntry<'projects'>) => ({ ...item, type: 'project' as const })),
  ...courseEntries.map((item: CollectionEntry<'courses'>) => ({ ...item, type: 'course' as const })),
].sort((a, b) =>
  (b.data.publishDate ? new Date(b.data.publishDate) : fallbackDate).valueOf() -
  (a.data.publishDate ? new Date(a.data.publishDate) : fallbackDate).valueOf()
);

const seo = {
  title: "Projects",
  description: "All my software builds, courses, and competition projects in one place.",
};
---
<Layout seo={seo}>
  <div class="pad pt-10 pb-16">
    <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4.5rem)]">Projects</h1>
    <p class="mt-4 max-w-[70ch] text-lg">A single hub for my open-source projects, courses, and competition builds.</p>

    <h2 class="disp text-ink mt-14 mb-3 text-[clamp(1.75rem,3vw,2.5rem)]">Projects &amp; Courses</h2>
    <ol class="index">
      {combinedBuilds.map((item) => (
        <li>
          <a
            class="index-row"
            href={item.type === 'project' ? `/projects/${item.id}/` : `/courses/${item.id.replace(/\/index$/, '')}/`}
          >
            <span class="lab">{item.data.publishDate ? item.data.publishDate.getFullYear() : ''}</span>
            <span>
              <span class="ttl">{item.data.title}</span>
              <span class="block">{item.data.description}</span>
            </span>
            <span class="out lab">{item.type === 'project' ? 'Project' : 'Course'}</span>
          </a>
        </li>
      ))}
    </ol>

    <h2 class="disp text-ink mt-14 mb-3 text-[clamp(1.75rem,3vw,2.5rem)]">Competition Builds</h2>
    <p class="mb-6 max-w-[70ch]">
      Seven projects built for student competitions between 2020 and 2025, most of them Turkey's national TEKNOFEST and TÜBİTAK contests. Each was made to solve a specific problem, entered with a written report, and judged against other teams.
    </p>
    <div class="border-t-2 border-ink">
      {competitionProjects.map((project) => <CompetitionCard project={project} />)}
    </div>
  </div>
</Layout>
