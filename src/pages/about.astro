---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';
import { getSheets } from '../lib/sheets';

const sheets = await getSheets();
const pick = (slugs: string[]) => sheets.filter((sheet) => slugs.includes(sheet.slug));

// The path, in the order it happened. Each stage is a crop of the 'journey' drawing
// (src/lib/figures.ts) and lists the sheets that came out of it.
const stages = [
  {
    name: 'Robotics & mechatronics',
    line: 'Where it started: competition hardware that had to run in front of judges.',
    viewBox: '35 212 150 214',
    work: pick(['iris-smart-gas-ventilation', 'e-seed-autonomous-reforestation', 'piezo-powered-wheelchair-visibility']),
  },
  {
    name: 'Data analysis',
    line: 'Making sense of what those projects measured.',
    viewBox: '228 212 150 214',
    work: pick(['duray-school-nutrition-planner', 'ai-earthquake-impact-analysis-intervention']),
  },
  {
    name: 'Software development',
    line: 'Tools and web apps that other people use.',
    viewBox: '413 212 150 214',
    work: pick(['inventory-management-system', 'ai-powered-physics-graph-generator']),
  },
  {
    name: 'AI & machine learning',
    line: 'Models for detection and prediction.',
    viewBox: '608 212 150 214',
    work: pick(['earthquake-damage-prediction', 'aircraft-detection', 'aipts-ai-icu-patient-monitoring']),
  },
];

const tools = ['Python', 'AI/ML', 'Prompt Engineering', 'Linux', 'HTML', 'TypeScript', 'MS Office', 'Data Analysis', 'Multilingualism'];

const seo = {
  title: 'About Me',
  description: 'How Faisal Durbaa got from robotics and mechatronics to data, software and AI, with the projects from each stage.',
};
---
<Layout seo={seo}>
  <div class="about pad grid gap-x-14 pb-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    {/* Pinned on wide screens while the path scrolls beside it. */}
    <div class="intro">
      <h1 class="disp text-ink text-[clamp(2.25rem,4.6vw,4rem)]">
        I build things that <span class="text-mark">have to work</span> in front of other people.
      </h1>
      <p class="mt-6 max-w-[52ch] text-lg">
        I started in robotics and mechatronics, and followed the data those projects produced into analysis, software and AI. That path is why I still care about the whole system, from the sensor to the screen.
      </p>
      <p class="mt-4 max-w-[52ch] text-lg">I'm on a gap year from Harvard University.</p>
      <ul class="mt-6 flex max-w-[30rem] flex-wrap gap-2" aria-label="Tools">
        {tools.map((tool) => <li class="lab border border-rule px-2.5 py-1.5">{tool}</li>)}
      </ul>
      <p class="mt-7 flex flex-wrap gap-3">
        <a href="/contact/" class="btn-solid">Get in touch</a>
        <a href="/projects/" class="btn">See the work</a>
      </p>
    </div>

    <ol class="path" id="path">
      {stages.map((stage, i) => (
        <li class="station" data-station>
          <span class="node disp" aria-hidden="true">{i + 1}</span>
          <div class="flex items-center gap-5">
            <Figure name="journey" title={stage.name} viewBox={stage.viewBox} class="icon shrink-0 text-ink" />
            <div>
              <h2 class="disp text-ink text-[clamp(1.6rem,2.6vw,2.25rem)]">{stage.name}</h2>
              <p class="mt-2 max-w-[38ch]">{stage.line}</p>
            </div>
          </div>
          <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {stage.work.map((sheet) => (
              <li>
                <a class="plate-link" href={sheet.href}>
                  {sheet.figure && <Figure name={sheet.figure} title={sheet.title} class="text-ink" />}
                  <span class="lab mt-2 block">{sheet.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
      <li class="station" data-station>
        <span class="node disp" aria-hidden="true">5</span>
        <h2 class="disp text-ink text-[clamp(1.6rem,2.6vw,2.25rem)]">Next</h2>
        <p class="mt-2 max-w-[38ch]">I'm always glad to hear from people working on something interesting.</p>
        <p class="mt-5"><a href="/contact/" class="btn-solid">Get in touch</a></p>
      </li>
    </ol>
  </div>
</Layout>

<style>
  .intro { padding-top: 2rem; }

  /* The path: a rail that fills in as you scroll, with a numbered node per stage. */
  .path { position: relative; list-style: none; margin: 2.5rem 0 0; padding: 0 0 0 3.25rem; --p: 0; }
  .path::before, .path::after { content: ''; position: absolute; left: 1.05rem; top: .5rem; bottom: 0; width: 2px; background: var(--rule); }
  .path::after { background: var(--mark); transform-origin: top; transform: scaleY(var(--p)); }
  .station { position: relative; padding-bottom: 4rem; }
  .station:last-child { padding-bottom: 0; }
  .node { position: absolute; left: -3.25rem; top: 0; z-index: 1; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border: 2px solid var(--ink); background: var(--ground); color: var(--ink); font-size: 1.25rem; transition: color .3s, border-color .3s; }
  .station[data-reached] .node { border-color: var(--mark); color: var(--mark); }

  .station :global(.icon) { width: 5.5rem; }
  /* Crops show the stage drawing only, without the journey figure's callouts. */
  .station :global(.icon circle.hl), .station :global(.icon text) { display: none; }

  .plate-link { display: block; height: 100%; border: 2px solid var(--ink); padding: .75rem; text-decoration: none; color: var(--ink); }
  .plate-link:hover, .plate-link:focus-visible { border-color: var(--mark); color: var(--mark); }

  /* Drawings wait for their station to be reached, then draw in. */
  @media (prefers-reduced-motion: no-preference) {
    .js .station:not([data-reached]) :global(.figure *) { animation-play-state: paused; }
  }

  @media (min-width: 1024px) {
    .intro { position: sticky; top: var(--header-h); align-self: start; padding-top: 3rem; }
    .path { margin-top: 3.5rem; }
    .station { padding-bottom: 5.5rem; }
  }
</style>

<script>
  // Fill the rail to the reading line and mark the stations it has passed.
  function bindPath() {
    const path = document.getElementById('path');
    if (!path) return;
    const about = path.closest('.about');
    about?.classList.add('js');
    const stations = [...path.querySelectorAll<HTMLElement>('[data-station]')];
    let queued = false;
    const update = () => {
      queued = false;
      if (!document.body.contains(path)) return window.removeEventListener('scroll', onScroll);
      const line = window.innerHeight * 0.72;
      const box = path.getBoundingClientRect();
      path.style.setProperty('--p', String(Math.min(1, Math.max(0, (line - box.top) / box.height))));
      for (const station of stations) {
        if (station.getBoundingClientRect().top < line) station.dataset.reached = 'true';
      }
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
  bindPath();
  document.addEventListener('astro:after-swap', bindPath);
</script>
