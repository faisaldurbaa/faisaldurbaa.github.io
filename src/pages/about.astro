---
import Layout from '../layouts/Layout.astro';
import Figure from '../components/Figure.astro';

const seo = {
  title: "About Me",
  description: "Learn more about Faisal Durbaa, his skills, and professional background."
};

const skills = ['Python', 'AI/ML', 'Prompt Engineering', 'Linux', 'HTML', 'TypeScript', 'MS Office', 'Data Analysis', 'Multilingualism'];

// Each stage is a crop of the 'journey' drawing (src/lib/figures.ts). All crops share one
// y-range so the drawings keep their common baseline; x-ranges stop short of the dashed hand-offs.
const stages = [
  { name: 'Robotics & mechatronics', line: 'Competition hardware for TEKNOFEST.', viewBox: '35 212 150 214' },
  { name: 'Data analysis', line: 'Making sense of what those projects measured.', viewBox: '228 212 150 214' },
  { name: 'Software development', line: 'Tools and web apps people actually use.', viewBox: '413 212 150 214' },
  { name: 'AI & machine learning', line: 'Models for detection and prediction.', viewBox: '608 212 150 214' },
];
---
<Layout seo={seo}>
  <div class="about pad pt-10 pb-16">
    <h1 class="disp text-ink max-w-[22ch] text-[clamp(2.75rem,5.6vw,4.5rem)]">
      I build things that <span class="whitespace-nowrap text-mark">have to work</span> in front of other people.
    </h1>

    <ol class="path mt-10 grid gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-8 lg:grid-cols-4" aria-label="Path">
      {stages.map((stage, i: number) => (
        <li class="plate frame relative flex flex-col">
          <div class="draw relative px-4 pt-3 pb-4">
            <span class="disp text-mark num text-[3.5rem] leading-none" aria-hidden="true">{i + 1}</span>
            <Figure name="journey" title={stage.name} viewBox={stage.viewBox} class="text-ink -mt-8" />
          </div>
          <div class="txt border-t border-rule p-4">
            <h2 class="disp text-ink text-[1.35rem] sm:text-[1.65rem]"><span class="sr-only">{i + 1}. </span>{stage.name}</h2>
            <p class="mt-2 text-body">{stage.line}</p>
          </div>
          {i < stages.length - 1 && (
            <svg class="link" data-i={i} viewBox="0 0 40 16" aria-hidden="true" focusable="false">
              <path d="M0 8H38M30 2L38 8L30 14" />
            </svg>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-14 grid gap-x-16 gap-y-10 lg:grid-cols-[minmax(0,60ch)_minmax(0,1fr)]">
      <div class="max-w-[60ch] space-y-4 text-lg leading-relaxed">
        <p>I started in robotics and mechatronics, building competition hardware for TEKNOFEST. Working with the data those projects produced led me to data analysis, and from there to software development and AI. That path is why I still care about the whole system, from the sensor to the screen.</p>
        <p>I'm on a gap year from Harvard University. I'm always glad to hear from people working on something interesting.</p>
      </div>

      <div class="lg:border-l lg:border-rule lg:pl-10">
        <ul class="flex flex-wrap items-center gap-2" aria-label="Tools">
          <li class="lab mr-2 text-muted" aria-hidden="true">Tools</li>
          {skills.map((name: string) => (
            <li class="lab border border-rule text-ink" style="padding:6px 10px">{name}</li>
          ))}
        </ul>
        <p class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="btn-solid">Get in touch</a>
          <a href="/projects/" class="btn">See the work</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* The figure's scale label is going away site-wide; keep it off this page now. */
  .about .figure-wrap small { display: none; }
  /* The svg box must match the crop's aspect, or letterboxing reveals the neighbouring stages. */
  .about .plate .figure { height: clamp(12rem, 17vw, 16rem); width: auto; aspect-ratio: 150 / 214; margin-inline: auto; }
  /* Stage crops show the drawing only; the numbered callout balloons and their leaders are
     replaced by the plate's own number. Balloons are r=17 circles, leaders are the path just before each balloon. */
  .about .plate .figure circle[r="17"],
  .about .plate .figure text,
  .about .plate .figure path:has(+ circle[r="17"]) { display: none; }

  /* Phones: drawing beside the text so four plates stay short. */
  @media (max-width: 767px) {
    .about .plate { flex-direction: row; }
    .about .plate .draw { flex: 0 0 40%; padding: .5rem .5rem .75rem .75rem; }
    .about .plate .num { font-size: 2.25rem; }
    .about .plate .figure { height: 8.5rem; }
    .about .plate .figure-wrap { margin-top: -.5rem; }
    .about .plate .txt { flex: 1 1 auto; min-width: 0; border-top: 0; border-left: 1px solid var(--rule); align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  }

  .about .plate { transition: border-color 160ms ease; }
  .about .plate:hover { border-color: var(--mark); }

  /* Arrows joining the plates, sitting in the grid gap: downward when stacked,
     across within each row of two, across all three gaps in the row of four. */
  .about .link { position: absolute; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: square; overflow: visible; }
  .about .link { left: 50%; top: 100%; width: 2.5rem; height: 1rem; transform: translate(-50%, 0.75rem) rotate(90deg); }
  @media (min-width: 768px) {
    .about .link { left: 100%; top: 40%; width: 2.5rem; transform: none; }
    .about .link[data-i="1"] { display: none; }
  }
  @media (min-width: 1024px) {
    .about .link[data-i="1"] { display: block; }
  }
</style>
