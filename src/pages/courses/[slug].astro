---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ShareButton from '../../components/ShareButton.astro';
import RelatedContent from '../../components/RelatedContent.astro';

export async function getStaticPaths() {
  const courseEntries = (await getCollection('courses')).filter(
    (entry: CollectionEntry<'courses'>) => entry.data.lessonNumber === undefined
  );

  return courseEntries.map((entry: CollectionEntry<'courses'>) => {
    const courseSlug = entry.id.replace(/\/index$/, '');
    return {
      params: { slug: courseSlug },
      props: { entry, courseSlug },
    };
  });
}

const { entry, courseSlug } = Astro.props as { 
  entry: CollectionEntry<'courses'>;
  courseSlug: string; 
};

const allLessons = await getCollection(
  'courses',
  ({ id, data }: CollectionEntry<'courses'>) =>
    id.startsWith(`${courseSlug}/`) && data.lessonNumber !== undefined
);

const sortedLessons = allLessons.sort(
  (a: CollectionEntry<'courses'>, b: CollectionEntry<'courses'>) => (a.data.lessonNumber ?? 0) - (b.data.lessonNumber ?? 0)
);
---
<Layout seo={{
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.heroImage
}}>
  <div class="pad pt-10 pb-16 max-w-[1100px]">
    <div class="flex justify-between items-center gap-4 mb-10 lab">
      <a href="/projects/" class="text-ink hover:underline">&larr; Back to Projects</a>
      <ShareButton title={entry.data.title} />
    </div>

    <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4.5rem)]">{entry.data.title}</h1>
    <p class="mt-6 mb-12 max-w-[70ch] text-lg text-body">{entry.data.intro || entry.data.description}</p>

    <h2 class="disp text-ink text-3xl mb-4">Table of Contents</h2>
    <ol class="index">
      {sortedLessons.map((lesson: CollectionEntry<'courses'>, index: number) => (
        <li>
          <a href={`/courses/${courseSlug}/${lesson.id.split('/')[1]}`} class="index-row">
            <span class="no">{index + 1}</span>
            <span>
              <span class="ttl">{lesson.data.title}</span>
              <span class="block mt-1">{lesson.data.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <RelatedContent currentSlug={courseSlug} />
</Layout>
