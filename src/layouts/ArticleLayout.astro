---
import { render, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import ShareButton from '../components/ShareButton.astro';
import RelatedContent from '../components/RelatedContent.astro';

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'courses'> | CollectionEntry<'projects'>;
  backLink: string;
  backText: string;
  previousLesson?: CollectionEntry<'courses'> | null | undefined;
  nextLesson?: CollectionEntry<'courses'> | null | undefined;
  courseSlug?: string | undefined;
}

const { entry, backLink, backText, previousLesson, nextLesson, courseSlug } = Astro.props;
const { Content } = await render(entry);

const showRelatedContent = entry.collection === 'blog';
const date = entry.data.publishDate
  ? new Date(entry.data.publishDate).toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const tags = entry.data.tags ?? [];
---
<Layout defaultTheme="light" seo={{
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.heroImage
}}>
  <article class="pad pt-10 pb-16 grid gap-x-12 gap-y-6 lg:grid-cols-[13rem_minmax(0,1fr)]">
    <aside class="flex flex-col gap-3 lab text-muted lg:sticky lg:top-6 lg:self-start">
      <a href={backLink} class="text-ink hover:underline">&larr; {backText}</a>
      {date && <p>{date}</p>}
      {tags.length > 0 && <p>{tags.join(' / ')}</p>}
      <ShareButton title={entry.data.title} />
    </aside>

    <div class="min-w-0">
      <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4.5rem)]">{entry.data.title}</h1>
      <p class="mt-6 pb-6 border-b-2 border-ink max-w-[70ch] text-xl md:text-2xl leading-snug text-body">{entry.data.description}</p>

      <div class="mt-10 prose prose-lg dark:prose-invert max-w-[70ch] text-body
        prose-headings:font-display prose-headings:uppercase prose-headings:text-ink prose-headings:mt-12 prose-headings:mb-3
        prose-p:text-body prose-li:text-body prose-strong:text-ink prose-lead:text-body
        prose-a:text-ink prose-a:underline hover:prose-a:text-stamp
        prose-blockquote:border-l-2 prose-blockquote:border-ink prose-blockquote:text-muted prose-blockquote:not-italic
        prose-code:text-ink prose-pre:bg-panel prose-pre:text-body prose-pre:border prose-pre:border-rule prose-pre:rounded-none
        prose-hr:border-rule prose-th:text-ink prose-td:text-body prose-figcaption:text-muted
        prose-img:border prose-img:border-rule prose-img:rounded-none">
        <Content />
      </div>

      {(previousLesson || nextLesson) && courseSlug && (
        <nav class="mt-16 border-t-2 border-ink max-w-[70ch]" aria-label="Lesson navigation">
          {previousLesson && (
            <a href={`/courses/${courseSlug}/${previousLesson.id.split('/')[1]}/`} class="block border-b border-rule px-3 py-4 no-underline text-body hover:bg-ink hover:text-ground">
              <span class="lab block">&larr; Previous Lesson</span>
              <span class="font-display uppercase text-xl text-ink block mt-1 [a:hover_&]:text-ground">{previousLesson.data.title}</span>
            </a>
          )}
          {nextLesson && (
            <a href={`/courses/${courseSlug}/${nextLesson.id.split('/')[1]}/`} class="block border-b border-rule px-3 py-4 no-underline text-body hover:bg-ink hover:text-ground">
              <span class="lab block">Next Lesson &rarr;</span>
              <span class="font-display uppercase text-xl text-ink block mt-1 [a:hover_&]:text-ground">{nextLesson.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>

  {showRelatedContent && <RelatedContent currentSlug={entry.id} />}
</Layout>
