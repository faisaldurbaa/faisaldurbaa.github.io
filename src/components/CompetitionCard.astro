---
import type { CompetitionProject } from "../data/competitionProjects";
import Figure from "./Figure.astro";
import { slugify } from "../lib/sheets";

export interface Props {
  project: CompetitionProject;
  labels?: { problem: string; solution: string; theme: string };
}

const themeLabels: Record<CompetitionProject["theme"], string> = {
  safety: "Public Safety",
  health: "Health",
  accessibility: "Accessibility",
  environment: "Environment",
  education: "Education",
};

const { project, labels } = Astro.props;
const l = labels ?? { problem: "Problem", solution: "Solution", theme: themeLabels[project.theme] };
---
<article id={slugify(project.title)} class="scroll-mt-6 border-b border-rule py-8 grid gap-x-10 gap-y-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:has-[figure]:grid-cols-[minmax(0,2fr)_minmax(0,3fr)_auto]">
  <header>
    <h3 class="disp text-ink text-[clamp(1.75rem,3vw,2.5rem)]">{project.title}</h3>
    <p class="lab mt-3 text-muted">{project.yearTag} · {project.focus} · {l.theme}</p>
    <p class="mt-1">{project.roles.join(" · ")}</p>
    {project.achievement && <p class="stamp mt-5">{project.achievement}</p>}
  </header>
  <div class="max-w-[70ch] space-y-3">
    <p><span class="lab text-ink">{l.problem}</span><br />{project.problem}</p>
    <p><span class="lab text-ink">{l.solution}</span><br />{project.solution}</p>
    {project.links && (
      <p class="flex flex-wrap gap-x-6 gap-y-1 pt-1">
        {project.links.map((link: { href: string; label: string }) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-ink underline hover:no-underline">{link.label}</a>
        ))}
      </p>
    )}
  </div>
  <Figure name={slugify(project.title)} title={project.title} class="w-[220px] max-w-full md:col-span-2 lg:col-span-1 lg:row-start-1 lg:col-start-3" />
</article>
