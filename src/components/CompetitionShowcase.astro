---
import CompetitionCard from './CompetitionCard.astro';
import englishProjects from '../data/competitionProjects';
import { slugify } from '../lib/sheets';
import type { CompetitionProject } from '../data/competitionProjects';

interface Copy {
  title: string;
  intro: string;
  teknofest: string;
  tubitak: string;
  projectCount: string;
  disciplines: string;
  reports: string;
  problem: string;
  solution: string;
  themes: Record<CompetitionProject['theme'], string>;
}

interface Props {
  projects: CompetitionProject[];
  copy: Copy;
}

const { projects, copy } = Astro.props;
---
<div class="pad pt-10 pb-16">
  <h1 class="disp text-ink text-[clamp(2.5rem,5vw,4.5rem)]">{copy.title}</h1>
  <div class="mt-4 max-w-[70ch] space-y-2 text-lg">
    <p>{copy.intro}</p>
    <p><strong class="text-ink">TEKNOFEST</strong> — {copy.teknofest}</p>
    <p><strong class="text-ink">TÜBİTAK</strong> — {copy.tubitak}</p>
  </div>
  <p class="lab mt-5 text-muted">{projects.length} {copy.projectCount} · {copy.disciplines} · {copy.reports}</p>

  <div class="mt-8 border-t-2 border-ink">
    {/* Both language files list the same projects in the same order, so drawings follow the English titles. */}
    {projects.map((project, i) => (
      <CompetitionCard project={project} figure={englishProjects[i] && slugify(englishProjects[i].title)} labels={{ problem: copy.problem, solution: copy.solution, theme: copy.themes[project.theme] }} />
    ))}
  </div>
</div>
