---
interface Props {
  languageSwitch?: {
    current: 'en' | 'tr';
    alternateHref: string;
    alternateLabel: string;
    accessibleLabel: string;
  } | undefined;
}

const { languageSwitch } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/', also: [] },
  { name: 'Projects', href: '/projects/', also: ['/projects/', '/courses/', '/red/', '/en/red/'] },
  { name: 'Writing', href: '/blog/', also: ['/blog/'] },
  { name: 'About', href: '/about/', also: [] },
  { name: 'Contact', href: '/contact/', also: [] },
];

const path = Astro.url.pathname;
const isActive = (link: (typeof navLinks)[number]) =>
  path === link.href || link.also.some((prefix) => path.startsWith(prefix));
---
<header class="strip pad" lang="en">
  <a href="/" class="disp text-2xl text-ink" aria-current={path === '/' ? 'page' : undefined}>Faisal Durbaa</a>
  <nav class="lab flex flex-wrap items-center gap-x-6 gap-y-1 text-ink" aria-label="Main">
    {navLinks.map((link) => (
      <a href={link.href} aria-current={isActive(link) ? 'page' : undefined}>{link.name}</a>
    ))}
    {languageSwitch && (
      <a href={languageSwitch.alternateHref} hreflang={languageSwitch.current === 'en' ? 'tr' : 'en'} aria-label={languageSwitch.accessibleLabel}>
        {languageSwitch.alternateLabel}
      </a>
    )}
    <button id="theme-toggle" type="button" class="lab border border-ink px-2 py-1 hover:bg-ink hover:text-ground">Whiteprint</button>
  </nav>
</header>

<script>
  import { applyStoredTheme, registerThemePersistence } from '../lib/theme';

  registerThemePersistence();

  function syncToggle() {
    const button = document.getElementById('theme-toggle');
    if (!button) return;
    const isDark = document.documentElement.classList.contains('dark');
    // The button names the sheet you would switch to.
    button.textContent = isDark ? 'Whiteprint' : 'Blueprint';
    button.setAttribute('aria-label', isDark ? 'Switch to the light whiteprint theme' : 'Switch to the blueprint theme');
  }

  function toggleTheme() {
    const root = document.documentElement;
    const theme = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.add('theme-transition');
    root.classList.toggle('dark', theme === 'dark');
    root.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    syncToggle();
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
    window.setTimeout(() => root.classList.remove('theme-transition'), 250);
  }

  function init() {
    applyStoredTheme();
    syncToggle();
    const button = document.getElementById('theme-toggle');
    if (button && button.dataset.bound !== 'true') {
      button.dataset.bound = 'true';
      button.addEventListener('click', toggleTheme);
    }
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
